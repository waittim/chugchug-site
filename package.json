{
  "name": "chugchug-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run prerender",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/?lang=en",
      "/?lang=zh",
      "/?lang=zh-Hant",
      "/privacy.html?lang=en",
      "/privacy.html?lang=zh",
      "/privacy.html?lang=zh-Hant"
    ],
    "skipThirdPartyRequests": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react-snap": "^1.23.0",
    "vite": "^5.4.2"
  }
}
